OPENAI_API_KEY=sk...
# Optional: read directly by Hugging Face (dataset/model downloads) to avoid rate limits.
HF_TOKEN=hf_...

# Model per role (defaults shown: budget profile, Luna + Sol verifier).
# Higher-accuracy profile: MODEL_LOOK/ANSWER/BASELINE=gpt-6.1-sol, MODEL_CHECK/JUDGE=gpt-6-astra.
# look, answer and baseline need image input.
# Keep MODEL_BASELINE equal to MODEL_ANSWER so baselines differ by architecture, not model.
MODEL_CONTROLLER=gpt-6-luna
MODEL_LOOK=gpt-6-luna
MODEL_ANALYZE=gpt-6-luna
MODEL_ANSWER=gpt-6-luna
MODEL_CHECK=gpt-6.1-sol
MODEL_BASELINE=gpt-6-luna
MODEL_JUDGE=gpt-6.1-sol

# Reasoning effort per role (none/low/medium/high/xhigh/max; leave empty to omit).
# gpt-6-luna supports none; gpt-6.1-sol and gpt-6-astra start at low.
REASONING_EFFORT_CONTROLLER=none
REASONING_EFFORT_LOOK=medium
REASONING_EFFORT_ANALYZE=low
REASONING_EFFORT_ANSWER=medium
REASONING_EFFORT_CHECK=low
REASONING_EFFORT_BASELINE=medium
REASONING_EFFORT_JUDGE=low

# Agentic system: loop (controller decides) or pipeline (fixed six stages, ablation).
AGENT_MODE=loop
# When the loop ends without a verified answer (or abstains), answer with an independent single-shot
# second opinion instead, flagged for review (false = the loop on its own).
SECOND_OPINION=true
# Independent re-answers used to measure self-consistency in the loop (0 disables).
SELF_CONSISTENCY_SAMPLES=2

# Reasoning tokens count toward this limit.
MAX_COMPLETION_TOKENS=8000

# Frontend origin(s) allowed by the backend CORS policy (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:5173
