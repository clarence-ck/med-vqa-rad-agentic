# Vision model — used by ImageInterpreter only (must support multimodal/image input)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-mini-2026-03-17

# Text model — used by QuestionAnalyzer, KnowledgeRetriever, ReasoningAgent, VerificationAgent, and orchestrator
# Routed through HuggingFace Inference Router to gpt-oss-120b
HF_TOKEN=hf_...
TEXT_MODEL=openai/gpt-oss-120b:fastest
TEXT_MODEL_BASE_URL=https://router.huggingface.co/v1

# Frontend origin(s) allowed by the backend CORS policy (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:5173
